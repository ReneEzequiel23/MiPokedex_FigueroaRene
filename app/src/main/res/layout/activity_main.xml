<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yellow_pokedex"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_card_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.32" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_vertical_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <ImageView
        android:id="@+id/iv_pokeball_bg"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:src="@drawable/pokeball"
        android:alpha="0.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="-50dp"/>

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pokemon_name"
        android:textColor="@color/white"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pokemon_number"
        android:textColor="@color/gray_text"
        android:textSize="20sp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name" />

    <ImageView
        android:id="@+id/iv_star"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/estrella"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/white_card_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_white_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideline_card_top"
        app:layout_constraintVertical_bias="1.0" />

    <ImageView
        android:id="@+id/iv_pikachu"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:src="@drawable/pikachu"
        app:layout_constraintBottom_toTopOf="@+id/guideline_card_top"
        app:layout_constraintTop_toTopOf="@+id/guideline_card_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pokemon_type"
        android:background="@drawable/bg_type_tag"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_pikachu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_altura_label"
        style="@style/StatLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Altura"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_type"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_altura_value"
        style="@style/StatValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stat_height_value"
        android:layout_marginStart="16dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_altura_label"
        app:layout_constraintStart_toEndOf="@+id/tv_altura_label" />

    <TextView
        android:id="@+id/tv_peso_label"
        style="@style/StatLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Peso"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_altura_label"
        app:layout_constraintEnd_toEndOf="@+id/tv_altura_label" />

    <TextView
        android:id="@+id/tv_peso_value"
        style="@style/StatValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stat_weight_value"
        android:layout_marginStart="16dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_peso_label"
        app:layout_constraintStart_toEndOf="@+id/tv_peso_label" />

    <TextView
        android:id="@+id/tv_habilidad_label"
        style="@style/StatLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Habilidad"
        android:layout_marginStart="16dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_altura_label"
        app:layout_constraintStart_toEndOf="@+id/guideline_vertical_center" />

    <TextView
        android:id="@+id/tv_habilidad_value"
        style="@style/StatValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stat_ability_value"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_habilidad_label"
        app:layout_constraintStart_toStartOf="@+id/tv_habilidad_label" />

    <TextView
        android:id="@+id/tv_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/pokemon_description"
        android:textColor="@color/gray_text"
        android:textSize="18sp"
        android:textAlignment="center"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_peso_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/iv_arbok"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="24dp"
        android:src="@drawable/arbok"
        app:layout_constraintBottom_toTopOf="@+id/tv_arbok"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_arbok"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        android:text="Arbok N.º 0024"
        app:drawableStartCompat="@drawable/arrow_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_raichu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        android:text="Raichu N.º 0026"
        app:drawableEndCompat="@drawable/arrow_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/iv_raichu"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/raichu"
        app:layout_constraintBottom_toTopOf="@+id/tv_raichu"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>